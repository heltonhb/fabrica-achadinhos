# .env.example — Variáveis de ambiente da Fábrica de Achadinhos
# Copie para .env e preencha os valores

# Google Sheets (obrigatório)
GOOGLE_SHEETS_ID=1gckCWB0OzPQRgAMaMGj4J9wW48Ux8EDRcRNcRmR2Mq4
GOOGLE_SHEET_NAME=Produtos

# Gemini API (para geração de roteiros)
GEMINI_API_KEY=

# Google Cloud OAuth2 (para escrita na planilha)
# 1. Acesse console.cloud.google.com
# 2. Crie um projeto (ou use existente)
# 3. Ative a Google Sheets API
# 4. Crie credenciais OAuth2 > Tipo: Aplicativo desktop
# 5. Baixe o JSON e coloque na pasta do projeto
# 6. Compartilhe a planilha com seu email Google (Editor)
# O token é gerado por `python auth.py` (.google_token.json).
# Localmente o arquivo basta; na nuvem exponha o conteúdo como:
OAUTH_CLIENT_JSON=client_secret_763787912262-j7hphqndsoqe3lurvekfqh934ls7suuv.apps.googleusercontent.com.json

# Vitrine Vercel (Opção A: atualização com 1 clique)
# Crie em: vercel.com -> Seu Projeto -> Settings -> Git -> Deploy Hooks
VERCEL_DEPLOY_HOOK=
VERCEL_VITRINE_URL=https://fabrica-achadinhos-three.vercel.app

# Analytics da vitrine (GoatCounter, sem cookies)
# Code = parte antes de .goatcounter.com. 'off' desativa o rastreamento.
# Visitas próprias: abra a URL com ?semanalytics (ou em localhost).
GOATCOUNTER_CODE=helton
# Token da API (goatcounter.com -> usuário -> API) pro painel de métricas no app.
GOATCOUNTER_API_TOKEN=

# Webhook do Instagram (bot de comentários) — porta separada do Stitch (8000)
WEBHOOK_PORT=8001

